#!/usr/bin/env bash
#
# Per-metric retention for prometheus.
#
# We keep environmental metrics (temperature, humidity, electricity, etc.) for
# years but only need pi system metrics (node_*, etc.) for a few months.
# This script trims series outside the keep-list older than RETENTION_DAYS via
# the prometheus admin delete_series + clean_tombstones APIs.
#
# See: https://github.com/dasl-/pitools/issues/13

set -euo pipefail -o errtrace

PROM_URL="${PROM_URL:-http://localhost:9090}"
KEEP_REGEX="${KEEP_REGEX:-^(ambient_|city_|electricity_).*}"
RETENTION_DAYS="${RETENTION_DAYS:-90}"

# When true, log what would be deleted but do not call the destructive APIs.
# Default to true so a fresh install is non-destructive until an operator opts in.
DRY_RUN="${DRY_RUN:-true}"

# Floor on keep-list series count. If fewer are found, abort without deleting.
# We currently emit 11 distinct metrics matching KEEP_REGEX from sensors/*; 8
# leaves headroom for one or two sensors being temporarily offline at timer time.
SAFETY_MIN_KEEP_SERIES="${SAFETY_MIN_KEEP_SERIES:-8}"

main(){
    trap 'fail $? $LINENO' ERR

    local cutoff_epoch
    cutoff_epoch=$(date -u -d "${RETENTION_DAYS} days ago" +%s)
    local cutoff_human
    cutoff_human=$(date -u -d "@$cutoff_epoch" -Iseconds)

    info "Retention timer starting. cutoff=${cutoff_human} dry_run=${DRY_RUN}"

    local keep_series_count
    keep_series_count=$(countSeries "{__name__=~\"$KEEP_REGEX\"}")
    if (( keep_series_count < SAFETY_MIN_KEEP_SERIES )); then
        die "Sanity check failed: only $keep_series_count keep-list series matched KEEP_REGEX (expected >= $SAFETY_MIN_KEEP_SERIES). Refusing to delete."
    fi
    info "Sanity check passed: $keep_series_count keep-list series matched."

    local trim_selector
    trim_selector="{__name__=~\".+\",__name__!~\"$KEEP_REGEX\"}"

    if [[ "$DRY_RUN" != "false" ]]; then
        info "DRY_RUN: would delete the following series with end<=${cutoff_human} (set DRY_RUN=false to actually delete):"
        summarizeSeries "$trim_selector"
        return 0
    fi

    info "About to delete (with end<=${cutoff_human}):"
    summarizeSeries "$trim_selector"

    info "Calling delete_series..."
    curl -fsS -X POST "$PROM_URL/api/v1/admin/tsdb/delete_series" \
        --data-urlencode "match[]=$trim_selector" \
        --data-urlencode "end=$cutoff_epoch" >/dev/null

    info "Calling clean_tombstones..."
    curl -fsS -X POST "$PROM_URL/api/v1/admin/tsdb/clean_tombstones" >/dev/null

    info "Retention timer finished. Trimmed non-keep-list series with end<=${cutoff_human}."
}

# Count series matching the given selector via the /api/v1/series endpoint.
countSeries(){
    local selector="$1"
    curl -fsS --get "$PROM_URL/api/v1/series" \
        --data-urlencode "match[]=$selector" \
        | python3 -c 'import sys, json; print(len(json.load(sys.stdin)["data"]))'
}

# Log series count + distinct metric names matching a selector. Note this
# reports what *would* be touched right now; the actual delete_series call uses
# end=cutoff so it only tombstones samples old enough, but the matched series
# (by labelset) are the same.
summarizeSeries(){
    local selector="$1"
    curl -fsS --get "$PROM_URL/api/v1/series" \
        --data-urlencode "match[]=$selector" \
        | python3 -c "
import sys, json
data = json.load(sys.stdin)['data']
names = sorted({d['__name__'] for d in data})
print(f'  series matched: {len(data)} across {len(names)} distinct metric names')
print('  metric names: ' + ', '.join(names))
"
}

fail(){
    local exit_code=$1
    local line_no=$2
    local script_name
    script_name=$(basename "${BASH_SOURCE[0]}")
    die "Error in $script_name at line number: $line_no with exit code: $exit_code"
}

info(){
    echo -e "\x1b[32m$*\x1b[0m" # green stdout
}

warn(){
    echo -e "\x1b[33m$*\x1b[0m" # yellow stdout
}

die(){
    echo
    echo -e "\x1b[31m$*\x1b[0m" >&2 # red stderr
    exit 1
}

main "$@"
