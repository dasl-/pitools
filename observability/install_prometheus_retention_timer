#!/usr/bin/env bash
#
# Install the systemd service+timer that runs the prometheus retention timer.
# See: https://github.com/dasl-/pitools/issues/13

set -euo pipefail -o errtrace

BASE_DIR="$(dirname "$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )")"

main(){
    trap 'fail $? $LINENO' ERR

    info "\\nInstalling prometheus_retention_timer..."

    setupSystemd

    info "\\nFinished installing prometheus_retention_timer."
    info "Timer status:    sudo systemctl status prometheus-retention.timer"
    info "Trigger now:     sudo systemctl start prometheus-retention.service"
    info "Tail logs:       sudo journalctl -u prometheus-retention.service -f"
}

setupSystemd(){
    info "\\nSetting up systemd service + timer..."

cat <<-EOF | sudo tee /etc/systemd/system/prometheus-retention.service >/dev/null
[Unit]
Description=Trim prometheus series outside the keep-list older than retention window
After=prometheus.service
Requisite=prometheus.service

[Service]
Type=oneshot
# clean_tombstones is synchronous and rewrites compacted blocks; give it
# plenty of headroom so systemd doesn't kill the run mid-rewrite.
TimeoutStartSec=30min
Environment=HOME=/root
Environment=DRY_RUN=false
ExecStart=$BASE_DIR/observability/prometheus_retention_timer
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=PROMETHEUS_RETENTION
EOF

cat <<-EOF | sudo tee /etc/systemd/system/prometheus-retention.timer >/dev/null
[Unit]
Description=Daily prometheus retention trim

[Timer]
OnCalendar=*-*-* 09:00:00

[Install]
WantedBy=timers.target
EOF

    sudo chown root:root /etc/systemd/system/prometheus-retention.service
    sudo chown root:root /etc/systemd/system/prometheus-retention.timer
    sudo chmod 644 /etc/systemd/system/prometheus-retention.service
    sudo chmod 644 /etc/systemd/system/prometheus-retention.timer
    sudo systemctl enable /etc/systemd/system/prometheus-retention.timer
    sudo systemctl daemon-reload
    sudo systemctl restart prometheus-retention.timer
}

fail(){
    local exit_code=$1
    local line_no=$2
    local script_name
    script_name=$(basename "${BASH_SOURCE[0]}")
    die "Error in $script_name at line number: $line_no with exit code: $exit_code"
}

info(){
    echo -e "\x1b[32m$*\x1b[0m" # green stdout
}

warn(){
    echo -e "\x1b[33m$*\x1b[0m" # yellow stdout
}

die(){
    echo
    echo -e "\x1b[31m$*\x1b[0m" >&2 # red stderr
    exit 1
}

main "$@"
